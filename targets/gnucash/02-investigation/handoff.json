  "rules": [
    {
      "id": "R-001",
      "title": "A transaction must balance (double entry)",
      "kind": "validation",
      "statement": "The splits of a transaction must sum to zero in the transaction currency. If they do not, the engine reports an imbalance and completes the entry with a balancing split to an \"Imbalance\" account rather than storing an unbalanced transaction.",
      "formula": "sum(split.value_num / split.value_denom for split in transaction.splits) == 0\nif not balanced: add split to account \"Imbalance-<CUR>\" for the negated difference\n",
      "applies_to": [
        "Transaction",
        "Split.value_num",
        "Split.value_denom"
      ],
      "features": [
        "F-001"
      ],
      "examples": [],
      "status": "partial",
      "confidence": "medium",
      "evidence": [
        {
          "ref": "ev_1eba78691fc38891237c951760bafde3dce799377aaa4f3d92b52505765465e8",
          "kind": "craft",
          "locator": "libgnc-engine.dll functions xaccTransGetImbalance, xaccTransGetImbalanceValue, xaccTransScrubImbalance, get_balance_split (uses string 'Imbalance')",
          "note": "core-feature-find on 'Imbalance'"
        }
      ],
      "contradictions": [],
      "notes": "Static evidence only (functions and strings in the engine). The exact rounding/currency behaviour is unconfirmed until a run is observed."
    },
    {
      "id": "R-002",
      "title": "Amounts are stored as exact rational fractions (numerator / denominator)",
      "kind": "rounding",
      "statement": "Monetary amounts are not floats. Each amount is a pair (numerator, denominator); the denominator is the smallest currency unit (for example 100 for euros/cents). This avoids rounding drift across sums.",
      "formula": "amount = value_num / value_denom          # e.g. 360.00 EUR -> value_num=36000, value_denom=100\na rebuild should store integer minor units (or a decimal/rational type), never a binary float\n",
      "applies_to": [
        "Split.value_num",
        "Split.value_denom",
        "Split.quantity_num",
        "Split.quantity_denom"
      ],
      "features": [
        "F-001"
      ],
      "examples": [],
      "status": "partial",
      "confidence": "medium",
      "evidence": [
        {
          "ref": "ev_cbf4056701a84d18acffbdb4d89393e12eaa59fa7ca5fd6c609a892d290cce3e",
          "kind": "craft",
