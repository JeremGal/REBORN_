{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reborn.dev/contracts/entity.schema.json",
  "title": "Domain entity",
  "description": "targets/<id>/02-investigation/domain/<Entity>.yaml: one business object of the data model (Invoice, Customer, Lesson, Ticket...).",
  "type": "object",
  "required": ["name", "description", "fields", "status", "evidence"],
  "additionalProperties": false,
  "properties": {
    "name": { "$ref": "common.schema.json#/$defs/entityName" },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "label": { "type": "string", "description": "Label shown in the original UI." },
          "type": { "enum": ["string", "text", "integer", "decimal", "money", "percent", "boolean", "date", "datetime", "time", "enum", "ref", "file", "json"] },
          "required": { "type": "boolean" },
          "unique": { "type": "boolean" },
          "max_length": { "type": "integer", "minimum": 1 },
          "precision": { "type": "integer", "minimum": 0, "description": "Decimal places for decimal / money." },
          "enum_values": { "type": "array", "items": { "type": "string" } },
          "ref": { "$ref": "common.schema.json#/$defs/entityName" },
          "default": { "type": ["string", "number", "boolean", "null"] },
          "computed_by": { "$ref": "common.schema.json#/$defs/ruleId" },
          "observed_as": { "type": "string", "description": "Original column / storage name if seen in a database or network payload." },
          "evidence": { "$ref": "common.schema.json#/$defs/evidenceList" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to", "kind"],
        "additionalProperties": false,
        "properties": {
          "to": { "$ref": "common.schema.json#/$defs/entityName" },
          "kind": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
          "via": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "lifecycle": { "type": "array", "items": { "type": "string" }, "description": "States in order: draft, validated, paid, archived..." },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string", "description": "SQLite, HFSQL, Access, SQL Server, REST API..." },
        "observed_table": { "type": "string" }
      }
    },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "evidence": { "$ref": "common.schema.json#/$defs/evidenceList", "minItems": 1 }
  }
}
