{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reborn.dev/contracts/observations.schema.json",
  "title": "Behaviour observations (block 1 output)",
  "description": "targets/<id>/01-exploration/observations.yaml: business behaviour noticed while running missions, each tied to run steps. These are the hypotheses block 2 confirms or refutes.",
  "type": "object",
  "required": ["target", "observations"],
  "additionalProperties": false,
  "properties": {
    "target": { "$ref": "common.schema.json#/$defs/targetId" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "kind", "runs"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/observationId" },
          "statement": { "type": "string" },
          "kind": { "enum": ["validation", "computation", "navigation", "format", "permission", "side-effect", "error-message", "default-value", "numbering", "workflow", "other"] },
          "where": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "screen": { "type": "string" }, "field": { "type": "string" } }
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["run"],
              "additionalProperties": false,
              "properties": { "run": { "$ref": "common.schema.json#/$defs/runId" }, "step": { "type": "integer", "minimum": 1 } }
            }
          },
          "suggests_rule": { "type": "string" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
