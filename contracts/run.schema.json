{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reborn.dev/contracts/run.schema.json",
  "title": "Agent run trace (block 1 output)",
  "description": "targets/<id>/01-exploration/runs/<run-id>/run.yaml: what the computer-use agent did and saw, step by step. Block 1 converts the agent's raw output into this shape.",
  "type": "object",
  "required": ["id", "mission", "agent", "target", "started_at", "outcome", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/runId" },
    "mission": { "$ref": "common.schema.json#/$defs/missionId" },
    "subject": { "enum": ["original", "rebuild"], "default": "original", "description": "original = legacy software, rebuild = block 3 app (parity replay)." },
    "agent": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "description": "h-company, human, claude-computer-use..." },
        "product": { "type": "string", "description": "agents-api, holotab..." },
        "model": { "type": "string" },
        "version": { "type": "string" },
        "raw_output": { "type": "string", "description": "Path to the untouched raw output (kept for audit)." }
      }
    },
    "target": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/targetId" },
        "version": { "type": "string" },
        "environment": { "type": "string", "description": "Windows VM, cloud browser, demo tenant..." }
      }
    },
    "started_at": { "$ref": "common.schema.json#/$defs/dateTime" },
    "ended_at": { "$ref": "common.schema.json#/$defs/dateTime" },
    "outcome": { "enum": ["success", "partial", "failed", "aborted"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "action"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "at": { "$ref": "common.schema.json#/$defs/dateTime" },
          "action": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["click", "double_click", "right_click", "type", "key", "scroll", "drag", "wait", "navigate", "read", "screenshot", "other"] },
              "target_desc": { "type": "string", "description": "Visible label or description of the element acted on." },
              "value": { "type": "string" }
            }
          },
          "screenshot": { "type": "string", "description": "Path relative to the run folder." },
          "screen": { "type": "string", "description": "S-xxx once known, otherwise the window or page title." },
          "observation": { "type": "string", "description": "What changed on screen, in plain words." },
          "extracted": { "type": "object", "description": "Values read on screen at this step (totals, generated numbers, messages)." }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "har": { "type": "string", "description": "Local path only: HAR files are gitignored (cookies, tokens)." },
        "video": { "type": "string" },
        "logs": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
