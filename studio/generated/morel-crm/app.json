 "ddl": [
  "CREATE TABLE \"clients\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"code\" TEXT NOT NULL UNIQUE,\n  \"raison_sociale\" TEXT NOT NULL,\n  \"siret\" TEXT,\n  \"adresse\" TEXT,\n  \"code_postal\" TEXT,\n  \"ville\" TEXT,\n  \"pays\" TEXT,\n  \"telephone\" TEXT,\n  \"email\" TEXT,\n  \"categorie\" TEXT CHECK (\"categorie\" IN ('standard', 'premium', 'partenaire')),\n  \"etat\" TEXT CHECK (\"etat\" IN ('actif', 'suspendu', 'radie')),\n  \"date_creation\" TEXT CHECK (\"date_creation\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"commercial\" TEXT,\n  \"remarques\" TEXT,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE TABLE \"prospects\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"societe\" TEXT NOT NULL,\n  \"nom\" TEXT,\n  \"prenom\" TEXT,\n  \"email\" TEXT,\n  \"telephone\" TEXT,\n  \"origine\" TEXT CHECK (\"origine\" IN ('salon', 'web', 'telephone', 'recommandation', 'mailing')),\n  \"stade\" TEXT CHECK (\"stade\" IN ('nouveau', 'qualifie', 'proposition', 'gagne', 'perdu')),\n  \"date_contact\" TEXT CHECK (\"date_contact\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"client\" INTEGER REFERENCES \"clients\"(\"id\") ON DELETE RESTRICT,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"prospects_client_idx\" ON \"prospects\" (\"client\")",
  "CREATE TABLE \"articles\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"reference\" TEXT NOT NULL UNIQUE,\n  \"designation\" TEXT NOT NULL,\n  \"famille\" TEXT,\n  \"prix_ht\" INTEGER,\n  \"tva\" TEXT CHECK (\"tva\" IN ('normal')),\n  \"actif\" INTEGER CHECK (\"actif\" IN (0, 1)),\n  \"stock\" INTEGER,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE TABLE \"devis\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"numero\" TEXT NOT NULL UNIQUE,\n  \"client\" INTEGER NOT NULL REFERENCES \"clients\"(\"id\") ON DELETE RESTRICT,\n  \"date\" TEXT NOT NULL CHECK (\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"statut\" TEXT CHECK (\"statut\" IN ('brouillon', 'envoye', 'accepte', 'refuse', 'expire')),\n  \"remise_pct\" REAL,\n  \"total_ht\" INTEGER,\n  \"total_tva\" INTEGER,\n  \"total_ttc\" INTEGER,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"devis_client_idx\" ON \"devis\" (\"client\")",
  "CREATE TABLE \"devis_lignes\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"devis\" INTEGER NOT NULL REFERENCES \"devis\"(\"id\") ON DELETE RESTRICT,\n  \"article\" INTEGER REFERENCES \"articles\"(\"id\") ON DELETE RESTRICT,\n  \"quantite\" INTEGER NOT NULL,\n  \"prix_unitaire\" INTEGER NOT NULL,\n  \"remise_pct\" REAL NOT NULL,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"devis_lignes_devis_idx\" ON \"devis_lignes\" (\"devis\")",
  "CREATE INDEX \"devis_lignes_article_idx\" ON \"devis_lignes\" (\"article\")",
  "CREATE TABLE \"factures\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"numero\" TEXT NOT NULL UNIQUE,\n  \"client\" INTEGER REFERENCES \"clients\"(\"id\") ON DELETE RESTRICT,\n  \"devis\" INTEGER REFERENCES \"devis\"(\"id\") ON DELETE RESTRICT,\n  \"date\" TEXT NOT NULL CHECK (\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"echeance\" TEXT CHECK (\"echeance\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"taux_tva\" REAL NOT NULL,\n  \"total_ht\" INTEGER NOT NULL,\n  \"total_tva\" INTEGER NOT NULL,\n  \"total_ttc\" INTEGER NOT NULL,\n  \"statut_paiement\" TEXT CHECK (\"statut_paiement\" IN ('non_payee', 'partielle', 'payee')),\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"factures_client_idx\" ON \"factures\" (\"client\")",
  "CREATE INDEX \"factures_devis_idx\" ON \"factures\" (\"devis\")",
  "CREATE TABLE \"factures_lignes\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"facture\" INTEGER NOT NULL REFERENCES \"factures\"(\"id\") ON DELETE RESTRICT,\n  \"article\" INTEGER REFERENCES \"articles\"(\"id\") ON DELETE RESTRICT,\n  \"quantite\" INTEGER NOT NULL,\n  \"prix_unitaire\" INTEGER NOT NULL,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"factures_lignes_facture_idx\" ON \"factures_lignes\" (\"facture\")",
  "CREATE INDEX \"factures_lignes_article_idx\" ON \"factures_lignes\" (\"article\")",
  "CREATE TABLE \"paiements\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"facture\" INTEGER NOT NULL REFERENCES \"factures\"(\"id\") ON DELETE RESTRICT,\n  \"date\" TEXT NOT NULL CHECK (\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"montant\" INTEGER NOT NULL,\n  \"mode\" TEXT CHECK (\"mode\" IN ('virement', 'cheque', 'lcr', 'carte')),\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"paiements_facture_idx\" ON \"paiements\" (\"facture\")",
  "CREATE TABLE \"activites\" (\n  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"client\" INTEGER REFERENCES \"clients\"(\"id\") ON DELETE RESTRICT,\n  \"prospect\" INTEGER REFERENCES \"prospects\"(\"id\") ON DELETE RESTRICT,\n  \"date\" TEXT CHECK (\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),\n  \"type\" TEXT CHECK (\"type\" IN ('appel', 'rendez_vous', 'email', 'visite')),\n  \"sujet\" TEXT,\n  \"note\" TEXT,\n  \"_source_key\" TEXT UNIQUE,\n  \"_migrated\" INTEGER NOT NULL DEFAULT 0,\n  \"_run_id\" TEXT,\n  \"_created_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),\n  \"_updated_at\" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n)",
  "CREATE INDEX \"activites_client_idx\" ON \"activites\" (\"client\")",
  "CREATE INDEX \"activites_prospect_idx\" ON \"activites\" (\"prospect\")",
  "CREATE TABLE IF NOT EXISTS \"_lineage\" (\"id\" INTEGER PRIMARY KEY, \"entity\" TEXT NOT NULL, \"record_id\" INTEGER NOT NULL, \"source_system\" TEXT, \"source_table\" TEXT NOT NULL, \"source_key\" TEXT NOT NULL, \"source_file\" TEXT, \"source_file_sha256\" TEXT, \"source_row\" TEXT NOT NULL, \"source_row_hash\" TEXT NOT NULL, \"target_row_hash\" TEXT NOT NULL, \"transforms\" TEXT, \"run_id\" TEXT NOT NULL, \"migrated_at\" TEXT NOT NULL, UNIQUE (\"entity\", \"record_id\"), UNIQUE (\"entity\", \"source_key\"))",
  "CREATE TABLE IF NOT EXISTS \"_files\" (\"id\" INTEGER PRIMARY KEY, \"entity\" TEXT NOT NULL, \"record_id\" INTEGER NOT NULL, \"filename\" TEXT NOT NULL, \"mime\" TEXT, \"size\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"storage\" TEXT NOT NULL, \"source_key\" TEXT, \"source_path\" TEXT, \"_migrated\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, \"created_by\" TEXT)",
  "CREATE INDEX IF NOT EXISTS \"_files_owner\" ON \"_files\" (\"entity\", \"record_id\")",
  "CREATE TABLE IF NOT EXISTS \"_audit\" (\"id\" INTEGER PRIMARY KEY, \"ts\" TEXT NOT NULL, \"user\" TEXT NOT NULL, \"action\" TEXT NOT NULL, \"entity\" TEXT, \"record_id\" INTEGER, \"before\" TEXT, \"after\" TEXT, \"justification\" TEXT)",
  "CREATE INDEX IF NOT EXISTS \"_audit_record\" ON \"_audit\" (\"entity\", \"record_id\")",
  "CREATE TABLE IF NOT EXISTS \"_users\" (\"id\" INTEGER PRIMARY KEY, \"username\" TEXT NOT NULL UNIQUE, \"password_hash\" TEXT NOT NULL, \"role\" TEXT NOT NULL CHECK (\"role\" IN ('admin', 'editor', 'viewer')), \"created_at\" TEXT NOT NULL, \"disabled\" INTEGER NOT NULL DEFAULT 0)",
  "CREATE TABLE IF NOT EXISTS \"_meta\" (\"key\" TEXT PRIMARY KEY, \"value\" TEXT NOT NULL)"
