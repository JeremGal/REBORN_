{
  "contract_version": "1.1",
  "module": "Devis",
  "application": "Quotix 98",
  "settings": {
    "discount_stacking": "compound",
    "rounding": {
      "decimals": 2,
      "mode": "half_up",
      "at": "end"
    },
    "currency": "EUR",
    "output_field": "total_price",
    "tolerance": 0.01
  },
  "inputs": [
    {
      "name": "quantity",
      "label": "Quantité",
      "type": "integer"
    }
  ],
  "outputs": [
    {
      "name": "total_price",
      "label": "Total HT",
      "format": "currency",
      "primary": true
    }
  ],
  "notes": "Blind Challenge : la remise volume ≥ 10 unités est passée de 10 % à 15 %.",
  "rules": [
    {
      "id": "RULE_009",
      "type": "exception",
      "description": "Quantité hors limites",
      "condition": {
        "any": [
          {
            "quantity_lt": 1
          },
          {
            "quantity_gt": 999
          }
        ]
      },
      "action": {
        "error": "QUANTITE INVALIDE (1-999)"
      },
      "confidence": 0.9,
      "validation_status": "tested",
      "evidence": [
        "EXP_023"
      ]
    },
    {
      "id": "RULE_001",
      "type": "unit_price",
      "description": "Prix unitaire article A",
      "group": "unit_price",
      "condition": {
        "product": "A"
      },
      "action": {
        "unit_price": 100
      },
      "confidence": 0.99,
      "validation_status": "validated",
