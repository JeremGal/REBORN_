{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "default": "1.0",
      "type": "string"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "discovered_by": {
      "type": "string"
    },
    "login": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "username_field": {
          "type": "string",
          "minLength": 1
        },
        "password_field": {
          "type": "string",
          "minLength": 1
        },
        "session_cookie": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "username_field",
        "password_field"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "string"
    },
    "mechanisms": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "default": "export",
            "type": "string",
            "enum": [
              "export",
              "api",
              "archive",
              "database"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[\\w.-]+$"
          },
          "requires": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "not_extractable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "system",
    "mechanisms"
  ],
  "additionalProperties": false
}
