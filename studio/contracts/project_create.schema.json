{
  "$comment": "GÉNÉRÉ par platform/src/lib/contracts-export.ts — ne pas modifier à la main (npm run contracts). Contrat project_create 1.3.",
  "title": "project_create",
  "description": "Création d'un projet de migration par un compte client connecté (propriétaire → Studio). L'autorisation est enregistrée au nom du compte ; les identifiants sont chiffrés et jamais renvoyés. 1.3 : aucun consentement présumé — authorization_version exigée, et credentials_notice_version dès que des identifiants sont confiés (400 sans elles, 409 si périmées).",
  "x-contract-version": "1.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "software": {
      "type": "string",
      "maxLength": 120
    },
    "legacy_url": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?:\\/\\/[^\\s/?#@]+(?:[/?#]\\S*)?$"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "software_type": {
      "type": "string",
      "maxLength": 80
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "authorized": {
      "type": "boolean",
      "const": true
    },
    "authorization_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "authorized_by": {
      "type": "string",
      "maxLength": 120
    },
    "credentials": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 24
        }
      },
      "required": [
        "username",
        "password"
      ],
      "additionalProperties": false
    },
    "credentials_notice_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    }
  },
  "required": [
    "company",
    "authorized"
  ],
  "additionalProperties": false
}
