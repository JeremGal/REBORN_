{
  "$comment": "GÉNÉRÉ par platform/src/lib/contracts-export.ts — ne pas modifier à la main (npm run contracts). Contrat business_model 1.0.",
  "title": "business_model",
  "description": "Modèle métier exécutable (Analyste / Alan → Studio) : modules de règles du moteur REBORN et liaisons aux entités.",
  "x-contract-version": "1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "default": "1.0",
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "maxLength": 120
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,59}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "module": {
            "default": "Module",
            "type": "string"
          },
          "application": {
            "type": "string"
          },
          "rules": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "type": {
                  "default": "custom",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "condition": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "action": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "validation",
                    "base",
                    "discount",
                    "fee",
                    "adjust",
                    "rounding"
                  ]
                },
                "priority": {
                  "type": "number"
                },
                "group": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "validation_status": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "action"
              ],
              "additionalProperties": {}
            }
          },
          "settings": {
            "type": "object",
            "properties": {
              "discount_stacking": {
                "type": "string",
                "enum": [
                  "compound",
                  "additive",
                  "max"
                ]
              },
              "rounding": {
                "type": "object",
                "properties": {
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "half_up",
                      "half_even",
                      "floor",
                      "ceil"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "enum": [
                      "end",
                      "each_step"
                    ]
                  }
                }
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "output_field": {
                "type": "string"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": {}
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  }
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "integer": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "help": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string",
                  "maxLength": 200
                },
                "max_length": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "display": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "select",
                    "segmented",
                    "cards",
                    "checkbox",
                    "toggle"
                  ]
                },
                "section": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": {}
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "currency",
                    "number",
                    "integer",
                    "percent",
                    "text"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "unit_singular": {
                  "type": "string"
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "primary": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "notes": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          }
        },
        "required": [
          "rules"
        ],
        "additionalProperties": {}
      }
    },
    "bindings": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scope": {
            "type": "string",
            "enum": [
              "line",
              "document"
            ]
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,59}$"
          },
          "document": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,59}$"
              },
              "via": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,59}$"
              }
            },
            "required": [
              "entity",
              "via"
            ],
            "additionalProperties": false
          },
          "lines": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,59}$"
              },
              "via": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,59}$"
              }
            },
            "required": [
              "entity",
              "via"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,59}(\\.[a-z][a-z0-9_]{0,59}){0,4}$"
                },
                {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,59}(\\.[a-z][a-z0-9_]{0,59}){0,4}$"
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "sum": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,59}(\\.[a-z][a-z0-9_]{0,59}){0,4}$"
                    }
                  },
                  "required": [
                    "sum"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "date_number": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,59}(\\.[a-z][a-z0-9_]{0,59}){0,4}$"
                    }
                  },
                  "required": [
                    "date_number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,59}$"
            }
          },
          "fields": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,59}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "money",
                    "decimal",
                    "percent",
                    "integer",
                    "text"
                  ]
                }
              },
              "required": [
                "name",
                "label",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "module",
          "scope",
          "entity",
          "inputs",
          "outputs"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ]
      }
    },
    "workflows": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "hypotheses": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "modules"
  ],
  "additionalProperties": false
}
