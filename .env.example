# ReBorn environment. Copy to .env (gitignored) and fill what you use. Never commit real values.

# Web page capture provider for `reborn doc` / `reborn web`.
# Leave empty to use Crawl4AI in Docker (default). Set to "linkup" to use the Linkup web agent.
WEB_PROVIDER=
LINKUP_API_KEY=

# Where REA runs (only if not auto-detected). Usually set in reborn.local.json instead.
# REBORN_REA_NODE=
# REBORN_REA_JS=
